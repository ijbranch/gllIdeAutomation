/* Version information for gllIdeAutomation.
 *
 * THIS FILE IS THE ONLY PLACE THE VERSION IS DEFINED.
 *
 * The .dproj's VerInfo_* mechanism is deliberately switched off
 * (VerInfo_IncludeVerInfo = false), because it cannot be reduced to a single
 * definition: Delphi keeps a Base copy plus one per build configuration, and
 * deleting the per-configuration copy only makes the next build write it back.
 * Worse, the IDE's own auto-increment advances FileVersion in that copy while
 * leaving ProductVersion behind, so the two can disagree in a shipped BPL.
 *
 * Everything below is driven by the five defines. Change VER_BUILD and
 * VER_STRING together, or let tools/bump-build.py do it for you.
 *
 * Every string VALUE ends in an explicit \0. The Delphi resource compiler,
 * unlike Microsoft's rc.exe, does not terminate them for you: without it a
 * string whose length does not land on a DWORD boundary runs straight into the
 * next key, and you get a FileDescription reading "gllIdeAutomation.FileVersion".
 * It is not decoration - do not remove it when editing a value.
 */

#define VER_MAJOR   1
#define VER_MINOR   0
#define VER_RELEASE 1
#define VER_BUILD   0
#define VER_STRING  "1.0.1.0\0"

/* 1 is VS_VERSION_INFO. Spelled numerically so this compiles without
   windows.h, which the Delphi resource compiler does not reliably provide. */
1 VERSIONINFO
FILEVERSION    VER_MAJOR, VER_MINOR, VER_RELEASE, VER_BUILD
PRODUCTVERSION VER_MAJOR, VER_MINOR, VER_RELEASE, VER_BUILD
FILEFLAGSMASK  0x3FL
FILEFLAGS      0x0L
FILEOS         0x40004L  /* VOS_NT_WINDOWS32 */
FILETYPE       0x2L      /* VFT_DLL          */
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        /* 0c09 = English (Australia), 04b0 = 1200 = Unicode */
        BLOCK "0c0904b0"
        BEGIN
            VALUE "CompanyName",      "GITLAK Software\0"
            VALUE "FileDescription",  "gllIdeAutomation\0"
            VALUE "FileVersion",      VER_STRING
            VALUE "InternalName",     "gllIdeAutomation\0"
            VALUE "LegalCopyright",   "Copyright (c) 2016-2026 Ian Branch (GITLAK Software) - MIT\0"
            VALUE "OriginalFilename", "gllIdeAutomation.bpl\0"
            VALUE "ProductName",      "gllIdeAutomation\0"
            VALUE "ProductVersion",   VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0c09, 1200
    END
END
